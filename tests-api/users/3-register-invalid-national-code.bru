meta {
  name: Register user - invalid national code (400)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "national_code": "0013542418",
    "name": "علی رضایی",
    "birth_date": "1995-03-21",
    "phone_number": "09123456789",
    "address": "تهران، خیابان آزادی",
    "postal_code": "1593656789",
    "password": "Str0ng-pass1"
  }
}

tests {
  test("400 VALIDATION_ERROR pointing at national_code", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("VALIDATION_ERROR");
    expect(res.body.errors[0].field).to.equal("national_code");
  });
}