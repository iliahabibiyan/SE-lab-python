meta {
  name: Update user - own contact info
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/users/{{userId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "phone_number": "09129998877",
    "address": "تهران، خیابان انقلاب، پلاک ۵",
    "postal_code": "1946813561"
  }
}

tests {
  // run "users/1-register-success" and "auth/1-login-success" first (or run the whole collection)
  test("200 OK with the new contact info and the same identity", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("userId"));
    expect(res.body.national_code).to.equal(bru.getVar("nationalCode"));
    expect(res.body.phone_number).to.equal("09129998877");
    expect(res.body.postal_code).to.equal("1946813561");
  });
}