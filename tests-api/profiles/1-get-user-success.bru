meta {
  name: Get user - own profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/users/{{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  // run "users/1-register-success" and "auth/1-login-success" first (or run the whole collection)
  test("200 OK with the profile and no sensitive fields", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("userId"));
    expect(res.body).to.not.have.property("password_hash");
    expect(res.body).to.not.have.property("password");
  });
}