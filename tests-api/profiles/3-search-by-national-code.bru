meta {
  name: Search user by national code
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/users?national_code={{nationalCode}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("200 OK with exactly the user we registered", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.have.length(1);
    expect(res.body.items[0].id).to.equal(bru.getVar("userId"));
    expect(res.body.next_cursor).to.equal(null);
  });
}