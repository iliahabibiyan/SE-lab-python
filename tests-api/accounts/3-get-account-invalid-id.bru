meta {
  name: Get account - malformed id (400)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/accounts/not-a-uuid
  body: none
  auth: none
}

tests {
  test("400 VALIDATION_ERROR pointing at account_id", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("VALIDATION_ERROR");
    expect(res.body.errors[0].field).to.equal("account_id");
  });
}