POSTGRES_USER=labbank
POSTGRES_PASSWORD=labbank
POSTGRES_DB=s1_accounts
DATABASE_URL=postgresql+psycopg2://labbank:labbank@localhost:5432/s1_accounts
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088
JWT_SECRET=change-me-to-a-long-random-string
# address of S2 (example: http://s2:8082); empty means S2 is not told about new accounts
S2_BASE_URL=

# optional settings (the defaults are in docker-compose.yml)
LOG_LEVEL=INFO
SEED_DATA=1
MAX_ACCOUNTS_PER_USER=5
S1_PORT=8081
FRONTEND_PORT=8080
DB_HOST_PORT=5432