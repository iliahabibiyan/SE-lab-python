POSTGRES_USER=labbank
POSTGRES_PASSWORD=labbank
POSTGRES_DB=s1_accounts
DATABASE_URL=postgresql+psycopg2://labbank:labbank@localhost:5432/s1_accounts
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088
# development only: a fixed value so that `cp .env.example .env` is enough to start. Use your own random value elsewhere.
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production-0f3a9c71b2d84e65
# address of S2; in Compose it is the S2 stub. Empty means S2 is not told about new accounts.
S2_BASE_URL=http://s2:8082

# optional settings (the defaults are in compose.yaml)
LOG_LEVEL=INFO
SEED_DATA=1
MAX_ACCOUNTS_PER_USER=5
S1_PORT=8081
FRONTEND_PORT=8080
DB_HOST_PORT=5432